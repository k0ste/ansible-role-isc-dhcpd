{% if lookup('ansible.builtin.vars', 'dhcpd_ddns_updates', default='')
  in ['on', 'off'] %}
{{ 'ddns-updates ' + lookup('ansible.builtin.vars', 'dhcpd_ddns_updates') +
  ';' }}
{% endif %}
{% if lookup('ansible.builtin.vars', 'dhcpd_ddns_update_style', default='')
  in ['standard', 'interim', 'none'] %}
{{ 'ddns-update-style ' + lookup('ansible.builtin.vars',
  'dhcpd_ddns_update_style') + ';' }}
{% endif %}
{% if lookup('ansible.builtin.vars', 'dhcpd_ddns_client_updates', default='')
  in ['allow', 'ignore'] %}
{{ lookup('ansible.builtin.vars', 'dhcpd_ddns_updates') + ' client-updates;' }}
{% endif %}
{% if lookup('ansible.builtin.vars', 'dhcpd_ddns_update_static_leases',
  default='') in ['on', 'off'] %}
{{ 'update-static-leases ' + lookup('ansible.builtin.vars',
  'dhcpd_ddns_update_static_leases') + ';' }}
{% endif %}
{% if lookup('ansible.builtin.vars', 'dhcpd_ddns_keys', default='')
  not in ['', [], '[]', None] %}
{% for k in lookup('ansible.builtin.vars', 'dhcpd_ddns_keys') %}
{{ 'key ' + k['name'] + ' {' }}
{{ '  algorithm hmac-md5;' }}
{{ '  secret ' + k['value'] + ';' }}
{{ '}' }}
{% endfor %}
{% endif %}
{% if lookup('ansible.builtin.vars', 'dhcpd_ddns_zones', default='')
  not in ['', [], '[]', None] %}
{% for z in hostvars[inventory_hostname]['dhcpd_ddns_zones'] %}
{{ 'zone ' + z['name'] + '. {' }}
{{ '  primary ' + z['primary'] + ';' }}
{{ '  key ' + z['key'] + ';' }}
{{ '}' }}
{% endfor %}
{% endif %}
